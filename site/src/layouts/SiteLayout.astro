---
import '../styles/global.css';
import { origin, repository, siteUrl } from '../../lib/paths.mjs';

const {
  title,
  description = 'A lightweight, customizable clock for the Windows 11 taskbar. ISO week dates, seconds, two lines: any format you like. Free, open source and native.',
  landing = false,
  documentation = false,
} = Astro.props;
const image = origin + siteUrl('icon.png');
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{title}</title>
  <meta name="description" content={description}>
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:image" content={image}>
  <link rel="icon" href={siteUrl('assets/icon.svg')} type="image/svg+xml">
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <header class={landing ? 'hero' : 'bar'}>
    <nav class="top" aria-label="Main navigation">
      <a class="brand" href={siteUrl()}><img src={siteUrl('assets/icon.svg')} alt="" width="32" height="32"> ElevenClock-rs</a>
      <div class="links">
        <a href={siteUrl('#features')}>Features</a>
        <a href={siteUrl('#try')}>Try a format</a>
        <a href={siteUrl('#install')}>Install</a>
        <a href={siteUrl('#faq')}>FAQ</a>
        <a href={siteUrl('docs/')} aria-current={documentation ? 'true' : undefined}>Documentation</a>
        <a href={repository}>GitHub</a>
      </div>
    </nav>
    <slot name="hero" />
  </header>

  <slot />

  <footer>
    {landing && <div class="footer-cta">
      <img src={siteUrl('assets/icon.svg')} alt="" width="56" height="56">
      <p>Make the taskbar clock yours.</p>
      <a class="button primary" href={`${repository}/releases/latest`}>Download ElevenClock-rs</a>
    </div>}
    <div class="footer-notes">
      <p><a href={siteUrl()}>Home</a> · <a href={siteUrl('docs/')}>Documentation</a> ·
        <a href={siteUrl('docs/guide/')}>User guide</a> ·
        <a href={`${repository}/releases/latest`}>Releases</a> ·
        <a href={repository}>Source</a></p>
      <p>Free and open source under the
        <a href={`${repository}/blob/main/LICENSE`}>Apache License 2.0</a>.
        Thanks to Martí Climent and the ElevenClock contributors for the original app,
        which inspired this one.</p>
      <p>Developed with help from AI coding agents, directed and reviewed by the
        maintainer. <a href={siteUrl('docs/guide/#ai-assistance')}>More</a></p>
      <p><a href={siteUrl('docs/guide/#code-signing-policy')}>Code signing policy</a> ·
        <a href={siteUrl('docs/code-of-conduct/')}>Code of conduct</a> ·
        Privacy: this program will not transfer any information to other networked
        systems unless specifically requested by the user or the person installing or
        operating it.</p>
    </div>
  </footer>
</body>
</html>
