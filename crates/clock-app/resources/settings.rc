#pragma code_page(65001)
#include <windows.h>
#include <commctrl.h>

// Control ids are shared with crates/clock-windows/src/settings.rs.
1 RT_MANIFEST "resources/app.manifest"
102 ICON "../../assets/icon.ico"

// Product name and version (from Cargo, via build.rs) shown in file properties and
// Task Manager, and checked by code signing.
#include "elevenclock_version.h"
1 VERSIONINFO
FILEVERSION ELEVENCLOCK_VERSION_NUMBER
PRODUCTVERSION ELEVENCLOCK_VERSION_NUMBER
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "ElevenClock-rs contributors"
            VALUE "FileDescription", "ElevenClock-rs"
            VALUE "FileVersion", ELEVENCLOCK_VERSION_TEXT
            VALUE "InternalName", "elevenclock-rs"
            VALUE "LegalCopyright", "Copyright 2026 ElevenClock-rs contributors. Apache License 2.0."
            VALUE "OriginalFilename", "elevenclock-rs.exe"
            VALUE "ProductName", "ElevenClock-rs"
            VALUE "ProductVersion", ELEVENCLOCK_VERSION_TEXT
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

// The Settings window. Dialog units follow the dialog font, so everything scales
// with the display (the manifest declares per-monitor DPI v2). The tab strip is only
// as tall as its tabs; the four page dialogs below are placed over the hidden 1106
// anchor, so no control overlaps another and tab order is simply document order.
101 DIALOGEX 0, 0, 340, 384
STYLE DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX
EXSTYLE WS_EX_APPWINDOW
CAPTION "ElevenClock-rs Settings"
FONT 9, "Segoe UI Variable Text"
BEGIN
    LTEXT "", 1101, 8, 8, 324, 24
    CONTROL "", 1100, "SysTabControl32", WS_TABSTOP | TCS_TABS, 8, 34, 324, 16
    LTEXT "", 1106, 8, 52, 324, 208, NOT WS_VISIBLE
    LTEXT "", 1107, 8, 266, 324, 12
    PUSHBUTTON "GitH&ub Releases", 1108, 8, 282, 90, 14, WS_TABSTOP
    PUSHBUTTON "Check &now", 1109, 104, 282, 66, 14, WS_TABSTOP
    AUTOCHECKBOX "Check for updates auto&matically", 1110, 8, 302, 324, 12, WS_TABSTOP
    LTEXT "", 1102, 8, 320, 324, 36
    PUSHBUTTON "E&xit ElevenClock-rs", 1003, 8, 362, 84, 14, WS_TABSTOP
    PUSHBUTTON "&Reset to defaults", 1104, 98, 362, 72, 14, WS_TABSTOP
    DEFPUSHBUTTON "OK", IDOK, 176, 362, 50, 14, WS_TABSTOP
    PUSHBUTTON "&Cancel", IDCANCEL, 230, 362, 50, 14, WS_TABSTOP
    PUSHBUTTON "&Apply", 1105, 284, 362, 48, 14, WS_TABSTOP
END

// Page 1: Date and time.
111 DIALOGEX 0, 0, 324, 208
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD
EXSTYLE WS_EX_CONTROLPARENT
FONT 9, "Segoe UI Variable Text"
BEGIN
    LTEXT "&Preset:", -1, 4, 6, 44, 10
    COMBOBOX 1201, 52, 4, 268, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "&Format (press Enter for a second line):", -1, 4, 22, 316, 10
    EDITTEXT 1202, 4, 33, 316, 26, ES_MULTILINE | ES_WANTRETURN | ES_AUTOVSCROLL | WS_VSCROLL | WS_TABSTOP
    LTEXT "", 1203, 4, 61, 316, 18
    LTEXT "Pre&view:", -1, 4, 82, 60, 10
    EDITTEXT 1204, 4, 93, 316, 46, ES_MULTILINE | ES_READONLY | WS_VSCROLL | WS_TABSTOP
    LTEXT "&Tokens:", -1, 4, 142, 60, 10
    EDITTEXT 1205, 4, 153, 316, 52, ES_MULTILINE | ES_READONLY | WS_VSCROLL | WS_TABSTOP
END

// Page 2: Appearance.
112 DIALOGEX 0, 0, 324, 208
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD
EXSTYLE WS_EX_CONTROLPARENT
FONT 9, "Segoe UI Variable Text"
BEGIN
    GROUPBOX "Show the clock on", -1, 4, 4, 316, 44
    AUTORADIOBUTTON "&Primary display only", 1301, 12, 17, 300, 12, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "A&ll displays", 1302, 12, 31, 300, 12
    LTEXT "Max &size (pt):", -1, 4, 58, 62, 10, WS_GROUP
    EDITTEXT 1303, 68, 56, 36, 14, ES_NUMBER | ES_AUTOHSCROLL
    CONTROL "", 1304, "msctls_updown32", UDS_SETBUDDYINT | UDS_ALIGNRIGHT | UDS_AUTOBUDDY | UDS_ARROWKEYS | UDS_NOTHOUSANDS, 104, 56, 10, 14
    LTEXT "6 to 24 pt", -1, 120, 58, 80, 10
    LTEXT "", 1305, 4, 74, 316, 20
    LTEXT "Clock &theme:", -1, 4, 102, 62, 10
    COMBOBOX 1306, 68, 100, 120, 60, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "The theme applies to the clock on the taskbar. This window follows your Windows colors and contrast settings.", -1, 4, 118, 316, 20
END


// Page 3: Startup. The checkbox is the Windows login registration itself (never a
// stored preference): it acts immediately and always shows what the registry holds.
// The status is a read-only field so it can be reached and read; the line below the
// Repair button says how the last action went and is announced to screen readers.
113 DIALOGEX 0, 0, 324, 208
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD
EXSTYLE WS_EX_CONTROLPARENT
FONT 9, "Segoe UI Variable Text"
BEGIN
    AUTOCHECKBOX "&Start ElevenClock-rs when I sign in to Windows", 1402, 4, 4, 316, 12, WS_TABSTOP
    LTEXT "Startup st&atus:", -1, 4, 24, 80, 10
    EDITTEXT 1401, 4, 35, 316, 52, ES_MULTILINE | ES_READONLY | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON "&Repair startup entry", 1404, 4, 91, 84, 14, WS_TABSTOP
    LTEXT "", 1405, 4, 109, 316, 24
    LTEXT "This applies to your Windows account only and needs no administrator rights. It takes effect immediately; Apply, Cancel and Reset to defaults do not change it. It is off until you turn it on.", -1, 4, 140, 316, 30
END

// Page 4: Support. Status, an explicit Refresh, the exact report that Copy
// diagnostics puts on the clipboard (selectable), and the result of the last
// refresh or copy in a line that is announced to screen readers.
114 DIALOGEX 0, 0, 324, 208
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD
EXSTYLE WS_EX_CONTROLPARENT
FONT 9, "Segoe UI Variable Text"
BEGIN
    LTEXT "&Status:", -1, 4, 4, 60, 10
    EDITTEXT 1501, 4, 15, 316, 52, ES_MULTILINE | ES_READONLY | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON "Re&fresh status", 1502, 4, 70, 70, 14, WS_TABSTOP
    LTEXT "Report &text that Copy diagnostics will copy:", -1, 4, 90, 316, 10
    EDITTEXT 1503, 4, 101, 316, 70, ES_MULTILINE | ES_READONLY | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON "Copy &diagnostics", 1504, 4, 175, 80, 14, WS_TABSTOP
    LTEXT "", 1505, 4, 192, 316, 14
END
